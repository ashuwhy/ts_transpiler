{
  "name": "typehl-converter",
  "version": "0.1.0",
  "description": "TypeScript → TypeHL Core Language transpiler for separation type verification",
  "type": "module",
  "bin": {
    "typehl": "./dist/cli.js"
  },
  "scripts": {
